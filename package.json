{
  "name": "mc-server-controller",
  "version": "1.0.0",
  "private": true,
  "description": "MC Server Controller monorepo",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:web": "pnpm --filter @mc-server-controller/web dev",
    "dev:api": "pnpm --filter @mc-server-controller/api start",
    "build": "pnpm --filter @mc-server-controller/web build",
    "preview": "pnpm --filter @mc-server-controller/web preview",
    "test": "pnpm --filter @mc-server-controller/api test && pnpm --filter @mc-server-controller/web test",
    "test:coverage": "pnpm --filter @mc-server-controller/api test:coverage && pnpm --filter @mc-server-controller/web test:coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.15.1",
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
